# HQ secrets. generated by ./setup.sh, never commit this file.
# everything non-secret lives in HQ.yml

SECRET_KEY=changeThis
ENCRYPTION_MASTER_KEY=changeThis
ENCRYPTION_MASTER_KEY_FALLBACKS=          # decrypt only, during rotation
POSTGRES_PASSWORD=changeThis
REDIS_PASSWORD=
FIRST_SUPERUSER=changeThis
FIRST_SUPERUSER_PASSWORD=changeThis
SMTP_PASSWORD=
DISCOURSE_CONNECT_SECRET=

# object storage, when deployment.storage.use is s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# provider keys. blank = users bring their own.
# sharing one with users is foundation.access in HQ.yml
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
VOYAGE_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ── generated by ./setup.sh, do not edit ──
# Values are deliberately absent: a shipped COMPOSE_PROJECT_NAME would point every
# `docker compose` run in this directory at another checkout's containers.
# Run `./setup.sh render` to fill this in.
