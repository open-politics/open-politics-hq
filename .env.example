# HQ secrets. generated by ./setup.sh, never commit this file.
# everything non-secret lives in my-hq.yml

SECRET_KEY=changeThis
ENCRYPTION_MASTER_KEY=changeThis
ENCRYPTION_MASTER_KEY_FALLBACKS=          # decrypt only, during rotation
POSTGRES_PASSWORD=changeThis
REDIS_PASSWORD=
FIRST_SUPERUSER=changeThis
FIRST_SUPERUSER_PASSWORD=changeThis
SMTP_PASSWORD=
DISCOURSE_CONNECT_SECRET=

# object storage, when deployment.storage.use is s3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# provider keys. blank = users bring their own.
# sharing one with users is foundation.access in my-hq.yml
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
VOYAGE_API_KEY=
MAPBOX_ACCESS_TOKEN=

# ── generated from my-hq.yml by ./setup.sh, do not edit ──
# render_env replaces everything below this line from my-hq.yml. The values are
# deliberately absent rather than plausible: a setup run that aborts before the
# first render leaves this file as-is, and a COMPOSE_PROJECT_NAME shipped here
# would make every `docker compose` command in that directory operate on some
# OTHER checkout's containers and volumes. Empty means compose falls back to the
# directory name, which is always scoped to where you are.
#
# Run `./setup.sh render` to fill this in.
